{
  "name": "salesforce-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Plan-first, multi-actor Playwright testing for Salesforce: process graphs, a visual planner, record-once replay, and self-painting results",
  "scripts": {
    "test": "playwright test --project=unit --project=harness",
    "test:unit": "playwright test --project=unit",
    "test:harness": "playwright test --project=harness",
    "test:e2e": "playwright test --project=e2e",
    "test:all": "playwright test",
    "sfpw": "node bin/sfpw.mjs",
    "record": "node bin/sfpw.mjs record",
    "pipeline": "node bin/sfpw.mjs pipeline",
    "sweep": "node bin/sfpw.mjs sweep",
    "suite": "node bin/sfpw.mjs suite",
    "graph:compose": "node bin/sfpw.mjs compose",
    "simulate": "node bin/sfpw.mjs simulate",
    "doctor": "node bin/sfpw.mjs doctor",
    "labour": "node tools/labour.mjs",
    "project:new": "node tools/scaffold-project.mjs",
    "ado:import": "node bin/sfpw.mjs import",
    "grillme": "node bin/sfpw.mjs grillme",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:encoding": "node L2/encoding/validate.mjs",
    "build:planner": "node tools/build-planner.mjs",
    "planner": "node tools/serve-planner.mjs"
  },
  "bin": {
    "sfpw": "bin/sfpw.mjs"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "cytoscape": "^3.34.2",
    "cytoscape-dagre": "^4.0.1",
    "cytoscape-edgehandles": "^4.0.1",
    "dagre": "^0.8.5",
    "dotenv": "^16.4.5",
    "eslint": "^10.9.1",
    "lodash": "^4.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "xlsx": "^0.18.5"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18"
  }
}
