    },
    {
      "id": "e_do_5",
      "from": "sess_siebel_admin",
      "to": "order",
      "type": "does",
      "label": "check the order is created",
      "data": {
        "catalog": "order.check"
      }
    },
    {
      "id": "e_end",
      "from": "sess_siebel_admin",
      "to": "end",
