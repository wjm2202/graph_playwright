      "id": "e_do_3",
      "from": "sess_risk_reviewer",
      "to": "scr_2",
      "type": "does",
      "label": "do the risk check",
      "data": {
        "catalog": "scr_2.do"
      }
    },
    {
      "id": "e_login_4",
      "from": "sess_risk_reviewer",
      "to": "sess_fulfiller",
