      "account": "admin"
    },
    "sales_user": {
      "kind": "internal",
      "role": "Sales User",
      "profile": "Standard User",
      "permissionSets": [],
      "account": "sales"
    },
    "portal_user": {
      "kind": "portal",
      "site": "portal",
      "license": "Customer Community Plus",
      "account": "portal"
    },
    "guest": {
      "kind": "guest",
      "site": "portal"
    },
    "lead_creator": {
      "kind": "internal",
      "role": "Lead Creator",
      "account": "lead_creator"
    },
    "lead_approver": {
      "kind": "internal",
      "role": "Lead Approver",
      "account": "lead_approver"
    },
    "credit_approver": {
      "kind": "internal",
      "role": "Credit Approver",
      "account": "credit_approver"
    },
    "siebel_admin": {
      "kind": "internal",
      "site": "siebel",
      "role": "Siebel Administrator",
      "account": "siebel_admin"
    },
    "client_associate": {
      "kind": "internal",
      "role": "Client Associate",
      "account": "client_associate"
    },
    "billing_collections": {
      "kind": "internal",
      "role": "Billing Collections and Debt management",
      "account": "billing_collections"
    },
    "client_lead": {
      "kind": "internal",
      "role": "Client Lead",
      "account": "client_lead"
    },
    "business_development_manager": {
      "kind": "internal",
      "role": "Business Development Manager",
      "account": "bdm"
    },
    "business_admin": {
      "kind": "internal",
      "role": "Business Admin",
      "account": "business_admin"
    }
