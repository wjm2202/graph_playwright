      "system": "siebel",
      "auth": "ui",
      "tokenEnv": ""
    },
    "client_associate": {
      "auth": "frontdoor"
    },
    "billing_collections": {
      "auth": "frontdoor"
    },
    "client_lead": {
      "auth": "frontdoor"
    },
    "bdm": {
      "auth": "frontdoor"
    },
    "business_admin": {
      "auth": "frontdoor"
    }
  },
  "personas": {
    "admin": {
      "kind": "internal",
      "role": "System Administrator",
