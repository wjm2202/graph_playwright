{
  "$schema": "./src/personas/personas.schema.json",
  "org": {
    "instanceUrlEnv": "SF_INSTANCE_URL"
  },
  "sites": {
    "portal": {
      "urlEnv": "SF_SITE_URL"
    },
    "siebel": {
      "urlEnv": "SIEBEL_URL"
    }
  },
  "accounts": {
    "admin": {
      "auth": "frontdoor"
    },
    "sales": {
      "auth": "frontdoor"
    },
    "portal": {
      "auth": "singleaccess"
    },
    "lead_creator": {
      "auth": "frontdoor"
    },
    "lead_approver": {
      "auth": "frontdoor"
    },
    "credit_approver": {
      "auth": "frontdoor"
    },
