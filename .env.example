# Copy to .env — never commit .env (gitignored). personas.json references these
# env-var NAMES; values live only here. Minimum for single-user e2e:
# SF_INSTANCE_URL + either SF_ACCESS_TOKEN or SF_USERNAME/SF_PASSWORD.

# ── Org under test (My Domain URL, e.g. https://yourorg--uat.sandbox.my.salesforce.com)
SF_INSTANCE_URL=

# ── Legacy single-user block (still works; resolves as the `admin` persona)
# Preferred: access token from `sf org display --json` (founding doc §4.2)
SF_ACCESS_TOKEN=
SF_USERNAME=
SF_PASSWORD=
SF_LOGIN_URL=https://test.salesforce.com

# ── Salesforce REST API version for data seeding
SF_API_VERSION=v61.0

# ── Experience Cloud site under test (personas.json site key: "portal")
SF_SITE_URL=

# ── Logins (personas.json → accounts). ONE block per login; several roles may
# share a login. Names are derived from the account id: SF_<ACCOUNT>_USERNAME/
# _PASSWORD/_TOKEN/_TOTP_SECRET (other systems use their own prefix). Token is
# preferred over password when set; TOTP only when the org enforces MFA.
# Pools: poolSize N in personas.json reads clones _W0…_W(N-1), e.g. SF_SALES_USERNAME_W0.

# admin — salesforce login for: System Administrator
SF_ADMIN_USERNAME=
SF_ADMIN_PASSWORD=
SF_ADMIN_TOKEN=
SF_ADMIN_TOTP_SECRET=

# sales — salesforce login for: Sales User
SF_SALES_USERNAME=
SF_SALES_PASSWORD=
SF_SALES_TOKEN=
SF_SALES_TOTP_SECRET=

# portal — salesforce login for: portal_user
SF_PORTAL_USERNAME=
SF_PORTAL_PASSWORD=
SF_PORTAL_TOKEN=
SF_PORTAL_TOTP_SECRET=

# lead_creator — salesforce login for: Lead Creator
SF_LEAD_CREATOR_USERNAME=
SF_LEAD_CREATOR_PASSWORD=
SF_LEAD_CREATOR_TOKEN=
SF_LEAD_CREATOR_TOTP_SECRET=

# lead_approver — salesforce login for: Lead Approver
SF_LEAD_APPROVER_USERNAME=
SF_LEAD_APPROVER_PASSWORD=
SF_LEAD_APPROVER_TOKEN=
SF_LEAD_APPROVER_TOTP_SECRET=

# credit_approver — salesforce login for: Credit Approver
SF_CREDIT_APPROVER_USERNAME=
SF_CREDIT_APPROVER_PASSWORD=
SF_CREDIT_APPROVER_TOKEN=
SF_CREDIT_APPROVER_TOTP_SECRET=

# siebel_admin — siebel login for: Siebel Administrator
SIEBEL_ADMIN_USERNAME=
SIEBEL_ADMIN_PASSWORD=
SIEBEL_ADMIN_TOTP_SECRET=

# client_associate — salesforce login for: Client Associate
SF_CLIENT_ASSOCIATE_USERNAME=
SF_CLIENT_ASSOCIATE_PASSWORD=
SF_CLIENT_ASSOCIATE_TOKEN=
SF_CLIENT_ASSOCIATE_TOTP_SECRET=

# billing_collections — salesforce login for: Billing Collections and Debt management
SF_BILLING_COLLECTIONS_USERNAME=
SF_BILLING_COLLECTIONS_PASSWORD=
SF_BILLING_COLLECTIONS_TOKEN=
SF_BILLING_COLLECTIONS_TOTP_SECRET=

# client_lead — salesforce login for: Client Lead
SF_CLIENT_LEAD_USERNAME=
SF_CLIENT_LEAD_PASSWORD=
SF_CLIENT_LEAD_TOKEN=
SF_CLIENT_LEAD_TOTP_SECRET=

# bdm — salesforce login for: Business Development Manager
SF_BDM_USERNAME=
SF_BDM_PASSWORD=
SF_BDM_TOKEN=
SF_BDM_TOTP_SECRET=

# business_admin — salesforce login for: Business Admin
SF_BUSINESS_ADMIN_USERNAME=
SF_BUSINESS_ADMIN_PASSWORD=
SF_BUSINESS_ADMIN_TOKEN=
SF_BUSINESS_ADMIN_TOTP_SECRET=

# ── Cached sessions: how long a .auth/<account>.json file is trusted before
# Cast re-authenticates. Default 2h (the common Salesforce session timeout).
# Your org's setting is the one that matters — if you see tests redirected to
# a login page mid-run, this is too high. 0 disables the cache entirely.
SESSION_MAX_AGE_MS=
