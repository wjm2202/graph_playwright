          "draft": true,
          "note": "draft from ADO — confirm once (planner: draft? button)",
          "kind": "api.record_exists",
          "target": "Case"
        }
      ]
    },
    {
      "id": "sess_reviewer",
      "type": "session",
      "label": "Salesforce · reviewer",
      "system": "sf",
      "actor": "reviewer"
    },
    {
      "id": "scr_1",
      "type": "screen",
      "label": "triage the request",
